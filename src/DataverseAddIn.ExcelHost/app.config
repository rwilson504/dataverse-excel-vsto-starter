<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Public Microsoft Entra ID app registration: covers Commercial and GCC.
         51f81489-12ee-4a9e-aaae-a2591f45987d is Microsoft's documented sample client,
         fine for testing but not for a shipped add-in. -->
    <add key="ClientId" value="51f81489-12ee-4a9e-aaae-a2591f45987d" />
    <add key="TenantId" value="organizations" />
    <add key="RedirectUri" value="http://localhost" />

    <!-- GCC High / DoD authenticate against Microsoft Entra Government. -->
    <add key="ClientId.UsGovernmentHigh" value="51f81489-12ee-4a9e-aaae-a2591f45987d" />
    <add key="ClientId.UsDepartmentOfDefense" value="51f81489-12ee-4a9e-aaae-a2591f45987d" />
  </appSettings>
</configuration>

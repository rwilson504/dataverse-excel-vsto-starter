<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <appSettings>
    <!-- Clouds to query, comma separated.
         Commercial | UsGovernmentCommunity | UsGovernmentHigh | UsDepartmentOfDefense | China -->
    <add key="Clouds" value="Commercial" />

    <!-- Default app registration, in public Microsoft Entra ID. Covers Commercial and
         UsGovernmentCommunity (GCC), which share public Entra identity.

         For local experimentation only, Microsoft's documented sample public client works
         against Commercial and GCC: 51f81489-12ee-4a9e-aaae-a2591f45987d
         It must not be shipped. See "Do I need my own app registration?" in README.md. -->
    <add key="ClientId" value="" />
    <add key="TenantId" value="organizations" />
    <add key="RedirectUri" value="http://localhost" />

    <!-- GCC High and DoD authenticate against Microsoft Entra Government, a separate directory.
         Register your own app there at https://portal.azure.us. Microsoft's sample client
         (51f81489-12ee-4a9e-aaae-a2591f45987d) does resolve in Entra Government and is fine
         for local testing; expect MFA or a device/location Conditional Access prompt rather
         than a hard block. -->
    <add key="ClientId.UsGovernmentHigh" value="51f81489-12ee-4a9e-aaae-a2591f45987d" />
    <add key="TenantId.UsGovernmentHigh" value="organizations" />
    <add key="ClientId.UsDepartmentOfDefense" value="" />
    <add key="TenantId.UsDepartmentOfDefense" value="organizations" />
  </appSettings>
</configuration>
